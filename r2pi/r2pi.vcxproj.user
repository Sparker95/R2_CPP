  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <RemoteDebuggerCommandArguments>-cfg_main /home/pi/projects/r2pi/MainConfig.cfg -cfg_platform /home/pi/projects/r2pi/PlatformConfig.cfg</RemoteDebuggerCommandArguments>
    <DebuggerFlavor>LinuxDebugger</DebuggerFlavor>
  </PropertyGroup>
</Project>